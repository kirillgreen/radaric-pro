# =============================================================================
# RADARIC — ENVIRONMENT VARIABLES
# =============================================================================
# Every UNCOMMENTED assignment below is verified against a real `process.env`
# read in the codebase (__tests__/docs-env-truth.test.ts); commented keys are
# documented but not test-covered. Configuration that lives in the DATABASE is
# deliberately absent — see "NOT ENV VARS" at the bottom.
#
# Quick start: `docker compose up` with a generated .env — see SELF_HOSTING.md.
# This file is the contract for a manual / Railway install.
# =============================================================================

# =============================================================================
# REQUIRED — the app does not work without these
# =============================================================================

# PostgreSQL connection string. Use a DIRECT (session-mode) connection, never a
# transaction-mode pooler: the worker's Telegram session lock uses session-level
# advisory locks, which a transaction pooler voids.
DATABASE_URL="postgresql://user:password@host:5432/radaric"

# NextAuth session signing key. REQUIRED and must be non-empty: copying the
# placeholder would sign sessions with a public value (forgeable admin sessions).
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Seals the integration tokens users save (Notion) before they reach the
# database. REQUIRED to save a Notion token; 32 bytes as 64 hex characters.
# Generate: openssl rand -hex 32 (scripts/generate-env.sh does it for you).
# Keep it safe and stable: without it, stored tokens cannot be read and users
# paste them again. Rotation and backfill: docs/SECURITY.md.
TOKEN_ENC_KEY=""
# During a rotation only — the old key, still accepted for reads:
# TOKEN_ENC_KEY_PREVIOUS=""

# Public base URL — builds Telegram/Parallel webhook URLs, email links and
# Stripe return URLs. REQUIRED in production: the Vercel fallback never fires on
# Railway or Docker, and webhook creation throws without it. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI configuration. The built-in filtering default is an OpenRouter model, so
# OPENROUTER_API_KEY is the zero-config choice. ANTHROPIC_API_KEY works instead
# for filtering/synthesis/discovery and the two Telegram stages (story writer,
# deduplication) once those are switched to a Claude model in
# Settings → AI Settings; material grouping is OpenRouter-only. (Also settable
# per-install in Settings → AI Settings, admin only.)
OPENROUTER_API_KEY=""
# ANTHROPIC_API_KEY="sk-ant-..."

# Or set a custom default for all AI stages. The endpoint must support
# POST /chat/completions with JSON Schema structured output. Saved selections
# in Settings still take precedence over this default.
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""
# Leave empty only if the gateway doesn't require a key.
OPENAI_COMPATIBLE_API_KEY=""

# =============================================================================
# OPTIONAL — features degrade cleanly when these are unset
# =============================================================================

# Recommended (not required): fallback base for password-reset links and OAuth
# callbacks. On a non-Docker install behind a proxy, leave unset so NextAuth
# derives the host — never set it to localhost on a server. Docker compose
# defaults this and NEXT_PUBLIC_APP_URL to http://localhost:3000, so a domain
# install must set both in .env.
# NEXTAUTH_URL="https://radaric.example.com"

# --- Self-hosting mode ---
# true = every subscription/tier gate unlocked for every account (multi-user
# self-host). A single-user install does NOT need it for access: the first
# account in an empty database becomes ADMIN automatically, and ADMIN bypasses
# every gate. It does pick the public pages: without the flag `/`, `/terms` and
# `/privacy` stay the hosted ones (see SELF_HOSTING.md).
# Docker: compose defaults this to true, so leave it unset — set `false` to sell
# subscriptions (see SELF_HOSTING.md).
# SELF_HOSTED=true

# --- Public contact address ---
# Support, refunds and privacy contact shown in the UI; unset = the hosted
# service's address.
# CONTACT_EMAIL="you@example.com"

# --- Docker compose only ---
# The Postgres superuser password compose puts into DATABASE_URL. It must be
# URL-safe: hex, never base64 (a `+` or `/` silently breaks the connection
# string). The app itself never reads this — compose interpolates it.
# Generate: openssl rand -hex 24
# POSTGRES_PASSWORD=""

# --- Email (verification + password reset) ---
# Resend API key. WITHOUT it, production signups fail CLOSED (accounts are
# created unverified and can't run AI until mail returns); a self-host without a
# mail provider sets ALLOW_UNVERIFIED_SIGNUP=1 instead, which creates accounts
# already verified.
# RESEND_API_KEY="re_..."
# Sender for verification and password-reset mail. MUST be an address on a
# domain your Resend account has verified — a self-host sending as radaric.pro is
# rejected. Unset = Radaric <noreply@radaric.pro> (the hosted service).
EMAIL_FROM=
ALLOW_UNVERIFIED_SIGNUP=

# --- Media storage (Cloudflare R2) ---
# Optional: without it, Telegram photos and video thumbnails are simply absent.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# --- Twitter/X parsing ---
# TwitterAPI.io key. Without it, Twitter/X sources report ERROR; everything else works.
# TWITTER_API_IO_KEY=""
# Delay between Twitter API calls, ms (default 5500).
# TWITTER_RATE_LIMIT_MS=5500

# --- Behance gallery reader (optional) ---
# When Behance answers the server with a bot-check page instead of a project,
# the gallery is read through r.jina.ai (a headless-browser reader). It works
# without a key at 20 requests/min per IP; a key raises the limit.
# JINA_API_KEY=""

# --- OAuth sign-in (optional; credentialed login always works) ---
# Buttons appear only for providers configured here.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_ID=""
# APPLE_SECRET=""

# --- Stripe billing (skip entirely for self-hosting) ---
# Only needed to SELL subscriptions. With SELF_HOSTED=true (or an ADMIN account)
# checkout/billing are unnecessary; the routes fail cleanly when unset.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_MONTHLY="price_..."        # Pro $59/mo
# STRIPE_PRICE_YEARLY="price_..."         # Pro $499/yr
# STRIPE_PRICE_LITE_MONTHLY="price_..."   # Lite $9/mo
# STRIPE_PRICE_LITE_YEARLY="price_..."    # Lite $90/yr

# --- Referral trial (optional) ---
# New accounts arriving with ?ref=<value> get a 7-day Lite trial, no card
# (lib/trial-ref.ts). Unset or blank turns the trial off.
# TRIAL_REF="launch"
# Set an ISO 8601 instant to close the trial from then on; unset, empty or
# unparseable = open-ended. Include Z or an offset: a bare date-time is read in
# the server's timezone. Trials already granted keep their 7 days.
# TRIAL_REF_ENDS_AT="YYYY-MM-DDT00:00:00Z"

# --- External archive search (optional integration) ---
# Read-only second database + OpenAI embeddings for related-material search.
# ARCHIVE_DATABASE_URL=""
# OPENAI_API_KEY=""

# --- Error reporting (Sentry) ---
# Server-side only; there is no browser-side reporting.
# SENTRY_DSN=""

# --- Story rubrics (optional) ---
# Comma-separated list the story writer may assign (your Notion "Рубрика"
# values). Unset → the generic starter set in lib/story-aggregator/schemas.ts.
# STORY_RUBRICS="News, Analysis, Tools"

# --- Worker / cost tuning (sensible defaults; leave unset unless tuning) ---
# WORKER_HEALTH_PORT=3001                  # worker health server port
# GRAMJS_STARTUP_DELAY_MS=30000            # Telegram connect delay (deploy-overlap guard)
# SELF_FILLING_CAP=10                      # tracked questions per non-admin user
# SELF_FILLING_SWEEP_INTERVAL_MS=120000    # worker sweep tick
# SELF_FILLING_FLOOR_INTERVAL_MS=900000    # cadence-freshness floor throttle
# SWEEP_MAX_REGENS=25                      # max answer regenerations per sweep
# SYNTH_DEBOUNCE_MS=300000                 # trailing-edge synthesis debounce
# MONITOR_RECONCILE_SCAN_CAP=500           # monitor reconcile scan size per tick
# MONITOR_RECONCILE_ACTIONS=25             # max pause/re-arm actions per tick
# ROUTING_BATCH_LIMIT=60                   # materials routed per user per run
# ROUTING_USER_RUN_EVAL_CAP=8              # story-routing evals per user per run
# ROUTING_USER_DAILY_CAP=200               # routed materials per user per 24h
# WORKER_TRIGGER_SECRET=""                 # enables POST /api/collections/regenerate-due

# --- Development only — never set in production ---
# PARALLEL_WEBHOOK_INSECURE=1              # accepts UNSIGNED Parallel webhook payloads
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING="1"  # only if Prisma engine download fails

# =============================================================================
# PROVIDED BY THE PLATFORM — do not set these yourself
# =============================================================================
# NODE_ENV, PORT            — runtime/platform
# RAILWAY_GIT_COMMIT_SHA, RAILWAY_DEPLOYMENT_ID — deployment identity (health endpoint)
# VERCEL_ENV, VERCEL_URL    — legacy Vercel fallbacks

# =============================================================================
# NOT ENV VARS — configured in the app (database), not here
# =============================================================================
# The following are set in the UI after first login, NOT via environment
# variables. Setting them here has no effect:
#
#   Telegram (Settings → Telegram, admin)   api id / api hash / session string
#   Parallel Monitor (Settings → Parallel)  api key / webhook secret
#   Notion (Settings per user)              token / database id
#   Story inbox channel (Settings, admin)   channel id
#   AI models (Settings → AI Settings)      per-stage models + Anthropic key
#
# Also removed: AUTH_USER / AUTH_PASSWORD_HASH (RAD-285). Bootstrap the operator
# with `node scripts/create-user.js <user> <pass> --admin` — or just sign up:
# the first account in an empty database becomes ADMIN.
